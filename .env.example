# Projet Supabase : bouton « Connect » ou Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Facultatif : nom et couleur principale de l'app
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_COLOR=

# Photos des plats — facultatif. Clé gratuite sur https://unsplash.com/developers
# Sans elle, les recettes gardent leurs vignettes colorées et le bouton
# « Chercher des photos » explique ce qui manque.
UNSPLASH_ACCESS_KEY=
